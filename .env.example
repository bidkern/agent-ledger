# Agent Ledger local development environment.
# Copy to .env.local and replace placeholders before running the app.

APP_URL="http://localhost:3260"
AUTH_STRATEGY="access-code"
ENABLE_ENTERPRISE_SSO="false"
ENABLE_LOCAL_DEMO="true"
ENABLE_LOCAL_TEST_ACCESS="false"

APP_ACCESS_CODE="replace-with-local-access-code"
APP_ACCESS_EMAILS="owner@example.com"
APP_ACCESS_DOMAINS=""
APP_ACCESS_GROUPS=""

SESSION_SECRET="replace-with-a-long-random-session-secret"
SESSION_MAX_AGE_SECONDS="28800"
AGENT_LEDGER_VAULT_KEY="replace-with-a-long-random-local-vault-key"
SERVICE_ACCOUNT_TOKENS="local-dev-service-token"

DATA_DIR=".agentledger-data"
STORAGE_BACKEND="filesystem"
DATABASE_URL=""
DATABASE_SSL="false"
SERVER_ACTIONS_ALLOWED_ORIGINS="http://localhost:3260"

AGENT_LEDGER_AUTONOMOUS_TICK_SECONDS="60"
AGENT_LEDGER_WORKER_SECONDS="60"
AGENT_LEDGER_WORKER_PROVIDER="mock"
AGENT_LEDGER_ALLOW_METERED_API="false"
AGENT_LEDGER_MODEL_MONTHLY_BUDGET_USD="5"
AGENT_LEDGER_MODEL_RUN_BUDGET_USD="1"
AGENT_LEDGER_ALLOW_WALLET_EXECUTION="false"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
ANTHROPIC_API_KEY=""
CLAUDE_API_KEY=""

ENABLE_RUNTIME_OAUTH="false"

OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=""
OIDC_SCOPES="openid profile email"
OIDC_TOKEN_AUTH_METHOD="client_secret_basic"
OIDC_EMAIL_CLAIM="email"
OIDC_NAME_CLAIM="name"
OIDC_GROUPS_CLAIM="groups"
OIDC_POST_LOGOUT_REDIRECT_URI=""
OIDC_END_SESSION_ENDPOINT=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""
STRIPE_BILLING_SUCCESS_URL=""
STRIPE_BILLING_CANCEL_URL=""
STRIPE_BILLING_PORTAL_RETURN_URL=""
STRIPE_PORTAL_CONFIGURATION_ID=""
