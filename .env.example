# Authentication strategy
AUTH_STRATEGY=access-code

# Founder workspace access for local development
APP_ACCESS_CODE=replace-with-a-long-random-passphrase
APP_ACCESS_EMAILS=founder@example.com,operator@example.com
APP_ACCESS_DOMAINS=
APP_ACCESS_GROUPS=
ENABLE_LOCAL_DEMO=false
ENABLE_LOCAL_TEST_ACCESS=false

# Session signing
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=28800

# Local default for desktop launch. Replace with your public HTTPS origin before deployment.
APP_URL=http://localhost:3260

# Enterprise SSO via OpenID Connect
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_GROUPS_CLAIM=groups
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_PROMPT=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_END_SESSION_ENDPOINT=

# Optional AI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Cost controls. Keep metered APIs disabled unless you intentionally want API billing.
AGENT_LEDGER_ALLOW_METERED_API=false
AGENT_LEDGER_MODEL_MONTHLY_BUDGET_USD=0.25
AGENT_LEDGER_MODEL_RUN_BUDGET_USD=0.06

# Wallet execution stays disabled until a dedicated guarded signer adapter exists.
AGENT_LEDGER_ALLOW_WALLET_EXECUTION=false

# Service tokens for external agents and guarded adapters.
# Format: service-id:token,another-service:another-token
SERVICE_ACCOUNT_TOKENS=local-agent:agentledger-local-service-token-change-me
AGENT_LEDGER_AUTONOMOUS_TICK_SECONDS=60
AGENT_LEDGER_WORKER_PROVIDER=openai
AGENT_LEDGER_WORKER_SECONDS=60

# Runtime data directory for filesystem-backed local storage
DATA_DIR=.agentledger-data

# Local vault encryption. Use a long random value before storing real secrets.
AGENT_LEDGER_VAULT_KEY=replace-with-a-long-random-local-vault-key

# Enterprise storage
STORAGE_BACKEND=filesystem
DATABASE_URL=
DATABASE_SSL=disable

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_BILLING_SUCCESS_URL=
STRIPE_BILLING_CANCEL_URL=
STRIPE_BILLING_PORTAL_RETURN_URL=
STRIPE_PORTAL_CONFIGURATION_ID=

# Include the production app host here before launch, especially behind a reverse proxy.
SERVER_ACTIONS_ALLOWED_ORIGINS=localhost:3260,127.0.0.1:3260
